# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- Floorwise ----
# keep the committed example env file
!.env.example
# runtime data (SQLite DB, seed bundle, uploads, audit archive)
/data/*
!/data/.gitkeep
# local TLS material for the optional tablet segment
/certificates/
# test output
/test-results/
/playwright-report/
